font=Geist
background-color=#100F0FFF

text-color=#CECDC3FF
border-size=1
border-radius=3
padding=6
max-icon-size=108
icon-border-radius=3
default-timeout=6000

[urgency=low]
border-color=#282726

[urgency=normal]
border-color=#403E3C

[urgency=critical]
border-color=#D14D41
default-timeout=120000
layer=overlay

[app-name=niri summary="Screenshot captured"]
on-button-left=exec file="$(ls -t "$HOME"/pictures/screenshots/*.png 2>/dev/null | head -n 1)"; [ -n "$file" ] && imv "$file" & makoctl dismiss
on-button-right=exec file="$(ls -t "$HOME"/pictures/screenshots/*.png 2>/dev/null | head -n 1)"; [ -n "$file" ] && satty -f "$file" & makoctl dismiss

